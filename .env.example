# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Admin
ADMIN_JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Database
DB_PATH=./data/openclaw.db

# API Keys
API_KEY_PREFIX=ocr
CORS_ORIGINS=*
RATE_LIMIT_DEFAULT_RPM=60

# Provider API Keys (override DB-stored keys)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# Custom OpenAI-compatible providers from env
# PROVIDER_OLLAMA_BASE_URL=http://localhost:11434/v1
# PROVIDER_OLLAMA_API_KEY=ollama
# PROVIDER_VLLM_BASE_URL=http://localhost:8000/v1
# PROVIDER_VLLM_API_KEY=empty

# Billing
MINIMUM_BALANCE_CENTS=0

# Logging
LOG_LEVEL=info
LOG_REQUESTS=true
